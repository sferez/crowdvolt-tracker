<?xml version="1.0" encoding="UTF-8"?>
<!-- Run the tracker from this Mac instead of (or as well as) GitHub Actions.
     Install:  cp com.sferez.crowdvolt-tracker.plist ~/Library/LaunchAgents/
               launchctl load ~/Library/LaunchAgents/com.sferez.crowdvolt-tracker.plist
     Unlike cron, launchd runs a missed job once the machine wakes. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sferez.crowdvolt-tracker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>track.py</string>
    <string>--delay</string>
    <string>1.5</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/sferez/Code/Random/crowdvolt-tracker</string>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/crowdvolt-tracker.log</string>
  <key>StandardErrorPath</key><string>/tmp/crowdvolt-tracker.err</string>
</dict>
</plist>
